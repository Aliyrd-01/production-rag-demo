# ── Qdrant Cloud ( rag_v2_q_test ) ───────────────────────────────────────────
QDRANT_URL=https://<cluster>.europe-west3-0.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=rag_v2_q_test

# ── FastEmbed ───────────────────────────────────────────────────────────────
# dense-модель обязана совпадать с той, по которой построен индекс (768d)
FASTEMBED_DENSE_MODEL=nomic-ai/nomic-embed-text-v1.5
FASTEMBED_SPARSE_MODEL=Qdrant/bm25
FASTEMBED_RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# ── LLM ─────────────────────────────────────────────────────────────────────
# Qubax (primary): OpenAI-совместимый, оплата криптой, от $3, без карты
QUBAX_API_KEY=
QUBAX_API_BASE=https://api.qubax.ai/v1
QUBAX_MODELS=qwen3-235b-a22b-2507,minimax-m2.5

# Судья для eval: НЕ должен совпадать с отвечающей моделью (иначе self-bias).
# qwen3-32b ~ $1.2/$4.2 за 1M токенов (дешевле minimax-m2.5 и быстрее glm-4.5-air).
JUDGE_MODEL=qwen3-32b

# Zen (OpenCode) — из-за Cloudflare 1010 вне opencode не работает
OPENAI_API_BASE=https://opencode.ai/zen/v1
OPENAI_API_KEY=

# OpenRouter free — последний резерв
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
ALLOW_OPENROUTER=1

MISTRAL_API_KEY=

# ── Tracing ─────────────────────────────────────────────────────────────────
# LangSmith — используется (проект production-rag), пишет трэйсы всех вызовов.
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_ENDPOINT=https://eu.api.smith.langchain.com
LANGCHAIN_PROJECT=production-rag
# Langfuse — выключен по умолчанию (только FastAPI-вариант, module_12_api).
ENABLE_LANGFUSE=