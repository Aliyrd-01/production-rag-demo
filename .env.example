# ============================================================
# RAG Production API — переменные окружения для облачного деплоя
# Заполнить и загрузить в Render/Railway как Environment secrets.
# НЕ коммитить настоящие ключи в git.
# ============================================================

# --- LLM генерация: Qubax (OpenAI-совместимый, как Qubax API) ---
# После миграции common.py будет читать эти переменные.
QUBAX_API_KEY=
QUBAX_BASE_URL=https://api.qubax.ai/v1
QUBAX_MODEL=
# QUBAX_EMBED_MODEL=            # если Qubax даёт embeddings

# --- Резервный LLM-стек (любой один обязателен) ---
OPENROUTER_API_KEY=
MISTRAL_API_KEY=

# --- Qdrant Cloud (уже облачный, не менять) ---
QDRANT_URL=https://f2feb92b-e82b-41ec-a4f2-969f7ff7b5fd.europe-west3-0.gcp.cloud.qdrant.io
QDRANT_API_KEY=
QDRANT_COLLECTION=rag_v2

# --- Только если нужен streaming / reranker на fastembed ---
# (скачивает модели при первом запуске внутри контейнера)
FASTEMBED_DENSE_MODEL=BAAI/bge-small-en-v1.5
FASTEMBED_SPARSE_MODEL=Qdrant/bm25
FASTEMBED_RERANKER_MODEL=BAAI/bge-reranker-base

# --- Логи в MySQL (опционально; можно оставить пустым, чтобы выключить) ---
RAG_MYSQL_HOST=auth-db936.hstgr.io
RAG_MYSQL_PORT=3306
RAG_MYSQL_USER=u543957720_crypto
RAG_MYSQL_PASS=
RAG_MYSQL_DB=u543957720_cryptoprice

# --- Безопасность API ---
# Если задать — /query и /logs требуют заголовок X-API-Key.
# Для демо работодателю можно оставить пустым.
API_KEY=
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- Прочее ---
CACHE_ENABLED=0
LANGCHAIN_TRACING_V2=false